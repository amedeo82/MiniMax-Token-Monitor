# Template variabili d'ambiente — MiniMax Token Monitor
#
# Copia questo file in .env e compila SOLO le variabili che ti servono.
# NESSUN valore qui sotto è reale: sono segnaposto.
# Il file .env è gitignored: non deve MAI finire nel repository.

# ── Persistenza server (opzionale) ─────────────────────────────────────────
# Con Turso (deployment serverless, Vercel):
TURSO_DATABASE_URL=libsql://<nome-db>-<org>.turso.io
TURSO_AUTH_TOKEN=<token-generato-dalla-console-turso>
# Senza Turso, il progetto usa automaticamente un file SQLite locale:
# DATABASE_URL=file:./db/custom.db
DATABASE_URL=file:./db/custom.db

# ── Protezione scritture (consigliata in produzione) ───────────────────────
# Guard delle scritture (archivi, manutenzione, proxy usage POST):
# confronto timing-safe dell'header x-admin-token. Se NON impostato le
# scritture restano aperte (accettabile solo in locale).
ADMIN_TOKEN=<valore-lungo-casuale-es-openssl-rand-hex-32>
# Token del cron di manutenzione giornaliero (vercel.json → /api/manutenzione/cron).
# OBBLIGATORIO se il cron è attivo: la route risponde 403 senza questo env.
CRON_SECRET=<valore-lungo-casuale>

# ── Limiti (opzionali, valori di default documentati nel README) ───────────
# Scritture per minuto per IP (default 120)
#RATE_LIMIT_WRITES_PER_MINUTO=120
# Pulizia automatica dopo la manutenzione (default dipende dall'ambiente)
#MANUTENZIONE_AUTO_PULIZIA=false

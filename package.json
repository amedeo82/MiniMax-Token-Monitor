{
  "name": "minimax-usage-monitor",
  "version": "0.2.1",
  "description": "Dashboard PWA per monitorare in tempo reale quota, finestre e reset del piano a token MiniMax (Token Plan / M Plan), con storico, analisi dei cicli e proiezioni — fuso Europe/Rome",
  "private": true,
  "license": "MIT",
  "author": "Amedeo Vecchi <amedeo.vecchi82@gmail.com> (https://github.com/amedeo82)",
  "homepage": "https://minimax-token-monitor.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amedeo82/MiniMax-Token-Monitor.git"
  },
  "bugs": {
    "url": "https://github.com/amedeo82/MiniMax-Token-Monitor/issues"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/verifiche/audit-implementazioni.mjs",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "verifiche": "node scripts/verifiche/verifica.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": "^3.1.9"
  }
}

// Schema Prisma — MiniMax Usage Monitor
//
// I16: persistenza server-side dello storico delle rilevazioni.
// I27: persistenza server-side del registro eventi (archivio oltre i 200
//      eventi conservati nel browser, per export completo e consultazione
//      di lungo periodo).
// Il browser resta la fonte primaria (localStorage), ma ogni punto/evento
// viene replicato (fire-and-forget) sul server per:
// - conservare uno storico più lungo (fino a 10.000 punti / 5.000 eventi)
// - consentire l'esportazione completa CSV/JSON oltre il buffer locale
// - abilitare future analisi di confronto tra finestre consecutive
//
// Nessun dato sensibile: le percentuali residue sono agigate senza chiavi API
// (la Subscription Key non viene MAI salvata sul server, resta nel browser).

generator client {
  provider = "prisma-client-js"
  // I115 — prisma 7: l'adapter è GA e OBBLIGATORIO (il client non ha più né
  // motore nativo né `datasourceUrl`): il preview flag «driverAdapters» è
  // deprecato e rimosso. L'URL non vive più nel datasource dello schema —
  // per il CLI vale prisma.config.ts, per il client la config dell'adapter
  // (src/lib/db-factory.ts).
}

datasource db {
  provider = "sqlite"
}

/**
 * Un punto dello storico quota: percentuale residua delle due finestre
 * del modello "general" al momento del rilevamento.
 */
model UsagePoint {
  id        Int      @id @default(autoincrement())
  /** Momento del rilevamento (epoch ms). Unico: dedup via upsert. */
  t         DateTime @unique
  /** % residua della finestra di 5 ore (null se non rilevata). */
  interval  Float?
  /** % residua della finestra settimanale (null se non rilevata). */
  weekly    Float?
  /** Origine del punto: "api" | "demo" | "import". */
  source    String   @default("api")
  /** Regione dell'endpoint interrogato: "eu" | "cn". */
  region    String   @default("eu")
  createdAt DateTime @default(now())

  @@index([t])
}

/**
 * I68 — Bucket orario derivato dello storico (downsampling).
 *
 * PER ORA UTC E ORIGINE aggrega i punti grezzi (UsagePoint) in
 * min/max/somma/ultimo per ciascuna finestra (interval/weekly) + conteggio:
 * la media dell'ora è somma/count. Serve a mantenere grafici ed export
 * leggeri quando l'archivio cresce (10.000 punti → ~417 ore per sorgente),
 * restando DISPONIBILE la grana fine per le analisi (I26+).
 *
 * È un DATO DERIVATO e ricostruibile al 100% dai punti grezzi (backfill
 * `scripts/verifiche/backfill-downsample.mjs`): viene mantenuto
 * incrementalmente dalla stessa POST di /api/history che salva il punto e
 * ripulito dallo stesso pruning a 90 giorni. Il dato GREZZO resta intatto.
 */
model DownsampledPoint {
  id        Int      @id @default(autoincrement())
  /** Inizio dell'ora UTC coperta dal bucket (es. 13:00:00.000Z). */
  hourStart DateTime
  /** Origine dei punti aggregati: "api" | "demo" | "import" (stessa di UsagePoint). */
  source    String   @default("api")

  /** Statistiche della finestra 5 ore nell'ora (null = nessun valore osservato). */
  minInterval  Float?
  maxInterval  Float?
  sumInterval  Float   @default(0)
  lastInterval Float?
  /** Statistiche della finestra settimanale nell'ora. */
  minWeekly  Float?
  maxWeekly  Float?
  sumWeekly  Float  @default(0)
  lastWeekly Float?

  /** Punti grezzi contribuiti al bucket (con almeno un valore non null). */
  count Int @default(0)
  /** Timestamp dell'ultimo punto contribuito (merge cronologico). */
  lastT DateTime

  createdAt DateTime @default(now())

  @@unique([hourStart, source])
  @@index([hourStart])
}

/**
 * Un evento del registro della dashboard (reset rilevato, soglia superata,
 * errore di rilevamento, nota informativa): replica server-side del registro
 * del browser (I27), che resta limitato a 200 voci in localStorage. Il server
 * conserva l'archivio completo per l'export e la consultazione di lungo periodo.
 */
model UsageEventRecord {
  /** Id dell'evento generato dal client (timestamp + contatore): dedup via upsert. */
  id        String   @id
  /** Momento dell'evento (epoch ms). */
  t         DateTime
  /** Tipo: "reset" | "warn" | "crit" | "error" | "info". */
  kind      String
  /** Modello coinvolto (es. "general") o null per eventi generici. */
  model     String?
  /** Finestra coinvolta ("interval" | "weekly") o null. */
  win       String?
  /** Descrizione in italiano mostrata nella timeline. */
  message   String
  /** % residua al momento dell'evento, se rilevante. */
  value     Float?
  createdAt DateTime @default(now())

  @@index([t])
  @@index([kind])
}

/**
 * I42/I82 — Un punto dello storico PER-MODELLO: percentuale residua di UNA
 * finestra (interval = la finestra breve del modello, es. 5 ore per general o
 * giornaliera 24h per video; weekly = la settimanale) di UN modello al momento
 * del rilevamento. Formato LONG (una riga per finestra): l'upsert deduplica
 * sulla chiave (model, win, t). Consumato dalla route /api/history/models (I82)
 * tramite `src/lib/server-model-history.ts` (SQL raw parametrizzato: l'accesso
 * non dipende dall'accessor tipizzato, che potrebbe mancare in un processo dev
 * con client generato prima del push — nota in testa alla lib).
 */
model ModelUsagePoint {
  id      Int    @id @default(autoincrement())
  /** Nome del modello come ritornato dall'API (es. "general", "video"). */
  model   String
  /** Finestra: "interval" | "weekly". */
  win     String
  /** Momento del rilevamento (epoch ms). Parte della chiave di dedup. */
  t       DateTime
  /** % residua osservata (0–100). */
  percent Float
  /** Origine del punto: "api" | "demo" | "import". */
  source  String @default("api")
  /** Regione dell'endpoint interrogato: "eu" | "cn". */
  region  String @default("eu")
  createdAt DateTime @default(now())

  @@unique([model, win, t])
  @@index([model])
  @@index([t])
}
